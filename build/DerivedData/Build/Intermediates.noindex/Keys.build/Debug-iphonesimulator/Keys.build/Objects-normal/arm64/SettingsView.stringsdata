          "startingLine": 610
        }
      },
      {
        "comment": "",
        "key": "Only titles and sites are indexed. Passwords, usernames, notes, and codes are never indexed.",
        "location": {
          "startingColumn": 22,
          "startingLine": 591
        }
      },
      {
        "comment": "",
        "key": "Share item names with Siri and Spotlight",
        "location": {
          "startingColumn": 24,
          "startingLine": 590
        }
      },
      {
        "comment": "",
        "key": "Siri & Spotlight",
        "location": {
          "startingColumn": 22,
          "startingLine": 595
        }
      },
      {
        "comment": "",
        "key": "Turning this off deletes every indexed item, not just future ones.",
        "location": {
          "startingColumn": 22,
          "startingLine": 597
        }
      },
      {
        "comment": "",
        "key": "The item on screen continues on your other devices. Handoff carries the item's identity, never its secrets.",
        "location": {
          "startingColumn": 22,
          "startingLine": 611
        }
      },
      {
        "comment": "",
        "key": "Siri can open an item, search the vault, generate a password, lock the vault, and check how many items need review. It never speaks a password.",
