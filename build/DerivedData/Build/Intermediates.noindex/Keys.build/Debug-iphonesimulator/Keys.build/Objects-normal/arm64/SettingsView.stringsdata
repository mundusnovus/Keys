          "startingColumn": 22,
          "startingLine": 530
        }
      },
      {
        "comment": "",
        "key": "Keys uses Apple Intelligence for drafting a login, explaining security findings, and turning a sentence into search filters.",
        "location": {
          "startingColumn": 22,
          "startingLine": 532
        }
      },
      {
        "comment": "",
        "key": "Apple Intelligence",
