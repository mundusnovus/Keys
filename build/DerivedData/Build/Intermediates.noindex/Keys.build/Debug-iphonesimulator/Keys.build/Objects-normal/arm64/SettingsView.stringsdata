      },
      {
        "comment": "",
        "key": "Logins, notes, cards, identities, Wi-Fi passwords, passkeys, and one-time codes sync inside the encrypted vault.",
        "location": {
          "startingColumn": 22,
          "startingLine": 440
        }
      },
      {
        "comment": "",
        "key": "Face ID keys, the clipboard, and this device's auto-lock choice stay on this device.",
