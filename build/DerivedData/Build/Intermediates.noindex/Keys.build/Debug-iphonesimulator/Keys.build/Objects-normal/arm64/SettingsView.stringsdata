        }
      },
      {
        "comment": "",
        "key": "Keys stores ciphertext in your private iCloud database. The master password never leaves your devices, so Apple cannot read an item. A change made on one device is picked up by the other when it is open, when it becomes active, and when the network returns.",
        "location": {
          "startingColumn": 22,
          "startingLine": 389
        }
      },
      {
        "comment": "",
        "key": "Checks every item against iCloud. It does not erase anything on this device.",
        "location": {
          "startingColumn": 22,
          "startingLine": 405
        }
      },
      {
        "comment": "",
        "key": "Sync Now",
        "location": {
