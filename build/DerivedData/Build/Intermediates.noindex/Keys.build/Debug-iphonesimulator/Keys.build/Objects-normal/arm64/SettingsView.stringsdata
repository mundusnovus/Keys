          "startingLine": 539
        }
      },
      {
        "comment": "",
        "key": "Apple Intelligence search",
        "location": {
          "startingColumn": 24,
          "startingLine": 541
        }
      },
      {
        "comment": "",
        "key": "Private Cloud Compute is Apple's server-side Apple Intelligence. It is used only for the security coach, and only with counts of findings. Capture and search stay on this device.",
        "location": {
          "startingColumn": 22,
          "startingLine": 548
        }
      },
      {
        "comment": "",
        "key": "This build does not have Apple's managed Private Cloud Compute entitlement. The app falls back to the on-device model. Request access from Apple, then add the entitlement to both configurations.",
        "location": {
          "startingColumn": 26,
          "startingLine": 552
        }
      },
      {
        "comment": "",
        "key": "Use Apple's servers for the security coach",
        "location": {
          "startingColumn": 24,
          "startingLine": 546
        }
      },
      {
        "comment": "",
        "key": "Request Private Cloud Compute access",
        "location": {
          "startingColumn": 30,
          "startingLine": 556
        }
      },
      {
        "comment": "",
        "key": "Passwords, usernames, site names, notes, card numbers, one-time codes, recovery keys, and passkey private keys.",
        "location": {
          "startingColumn": 22,
          "startingLine": 563
        }
      },
      {
        "comment": "",
        "key": "Capture and smart search run on this device. The coach receives counts and finding kinds only.",
        "location": {
          "startingColumn": 22,
          "startingLine": 564
        }
      },
      {
